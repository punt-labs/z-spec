# Generated by Rulesync from .rulesync/permissions.jsonc (permission.bash)
# https://developers.openai.com/codex/rules

# make *
prefix_rule(
    pattern = ["make", "*"],
    decision = "allow",
    justification = "Generated from Rulesync permission.bash: make *",
)

# git *
prefix_rule(
    pattern = ["git", "*"],
    decision = "allow",
    justification = "Generated from Rulesync permission.bash: git *",
)

# rm -rf *
prefix_rule(
    pattern = ["rm", "-rf", "*"],
    decision = "forbidden",
    justification = "Generated from Rulesync permission.bash: rm -rf *",
)

# *
prefix_rule(
    pattern = ["*"],
    decision = "prompt",
    justification = "Generated from Rulesync permission.bash: *",
)
