# macOS
.DS_Store
._*

# Editor
*.swp
*.swo
*~

# LaTeX build artifacts (for testing)
*.aux
*.log
*.fuzz
*.synctex.gz

# LaTeX build intermediates (biber, hyperref)
*.bbl
*.bcf
*.blg
*.run.xml

# PDFs (except deliverables)
*.pdf
!prfaq.pdf
!examples/*.pdf

# MCP (project-local, not part of plugin distribution)
.mcp.json

# Node.js dependencies
node_modules/

.claude/*
!.claude/settings.json
!.claude/hooks/

# Local-only files (machine-specific, per-user)
*.local
*.local.*

# Lux UI runtime state
Lux.ini

# Vox cached audio
.vox/*.mp3
docs/fuzz.sty
docs/*.mf
docs/*.pk
docs/*.tfm
docs/*.aux
docs/*.log
docs/*.fuzz
docs/*.toc
examples/fuzz.sty
examples/*.mf
examples/*.out
examples/*.toc
*.out


# Temp/config files
CLAUDE.md.tmp
Lux_Display.ini

# Z-spec reports (generated artifacts)
*.report.json
*.fuzz.json
*.partition.json
*.audit.json

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/

# Coverage artifacts (make coverage)
.coverage
htmlcov/

# Scratch/temp directory (TMPDIR set via .envrc)
.tmp/

# Local per-machine tool state under .punt-labs: only the local/ dir and
# *local*-named files (the global *.local / *.local.* rules above cover the
# latter). The ethos submodule, ethos.yaml, biff, and quarry are tracked or
# self-manage via their own .gitignore.
.punt-labs/local/

# The mandated sibling lock every punt CLI takes before mutating a shared host
# file (tool-enable-disable.md §2.4). It is per-machine runtime state, and it
# persists by design — unlinking a lock file races the next writer.
.*.punt-import.lock

uv.toml
