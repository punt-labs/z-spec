# only ignore user-specific state INSIDE them.)
xcuserdata/
DerivedData/
CoverageDerived/
*.xccheckout
*.xcresult
*.xcscmblueprint
*.hmap
*.dSYM
*.dSYM.zip
*.ipa
.swiftpm/
Package.pin
Package.resolved
Carthage/Build/
Carthage/Checkout
Pods/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
iOSInjectionProject/
playground.xcworkspace
timeline.xctimeline

# --- LaTeX build artifacts ---
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# === Repo-specific ===
# macOS
.DS_Store
._*

# Editor
*.swp
*.swo
*~

# LaTeX build artifacts (for testing)
*.aux
*.log
*.fuzz
*.synctex.gz

# LaTeX build intermediates (biber, hyperref)
*.bbl
*.bcf
*.blg
*.run.xml

# PDFs (except deliverables)
*.pdf
!prfaq.pdf
!examples/*.pdf

# MCP (project-local, not part of plugin distribution)
.mcp.json

# Node.js dependencies
node_modules/

# .claude/ is machine state except for the parts that are repo policy. Agent
# definitions are ethos's projection of this repo's team into Claude Code's
# subagent surface — generated, but configuration: every contributor who clones
# should get the same specialists, and a change to the roster belongs in a diff
# someone reviews, not in a file that silently differs per machine.
#
# The allowlist is per-agent, not the whole directory. ethos deposits every
# specialist it knows about into every repo it touches, so un-ignoring
# .claude/agents/ wholesale leaves eighteen Go, Swift, Kubernetes and product
# agents permanently untracked here — noise that hides a real change to the
# roster. The names below are punt-labs/z-spec's team, from
# .punt-labs/ethos/teams/formal-methods.yaml, less the two with no agent file:
# jfreeman, who is human, and claude, who leads rather than specialises.
# Adding a specialist to this repo means adding a line here, which is the
# review the comment above asks for.

# Local-only files (machine-specific, per-user)

# Lux UI runtime state
Lux.ini

# Vox cached audio
.vox/*.mp3
docs/fuzz.sty
docs/*.mf
docs/*.pk
docs/*.tfm
docs/*.aux
docs/*.log
docs/*.fuzz
docs/*.toc
examples/fuzz.sty
examples/*.mf
examples/*.out
examples/*.toc
*.out

# ...except the captured probcli transcripts. They are test fixtures — the
# contract the output parser is written against — not build noise.
!tests/fixtures/probcli/*.out


# Temp/config files
CLAUDE.md.tmp
Lux_Display.ini

# Z-spec reports (generated artifacts)
*.report.json
*.fuzz.json
*.partition.json
*.audit.json

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/

# Coverage artifacts (make coverage)
.coverage
htmlcov/

# Scratch/temp directory (TMPDIR set via .envrc)

# Local per-machine tool state under .punt-labs: only the local/ dir and
# *local*-named files (the global *.local / *.local.* rules above cover the
# latter). ethos.yaml, biff, and quarry are tracked or self-manage via their
# own .gitignore.
#
# .punt-labs/ethos/ is the mount point the org-wide convention puts the
# punt-labs/team submodule at, and this repo does not have that submodule. It
# was removed because z-spec ships as a marketplace plugin: `claude plugin
# install` clones with submodules, .gitmodules named the SSH URL
# git@github.com:punt-labs/team.git, and SSH auth fails before repo visibility
# is consulted — so every user without a GitHub key had the install abort. An
# HTTPS URL would fix the auth and still push 1 MB of internal identity data
# (247 files: identities, personalities, writing styles) onto their disk.
# Identity resolves from the global ~/.punt-labs/ethos/ instead, with the
# repo-local pointer in .punt-labs/ethos.yaml, which stays tracked. The
# trailing slash matters: it ignores the directory an `ethos` run may recreate
# here without ignoring that file. Do NOT re-add the submodule.
.punt-labs/ethos/

# Quarry's per-session working files. Machine state: regenerated each session,
# rewritten whenever the local index updates, and read by no one. Nothing here
# belongs in version control.

# The mandated sibling lock every punt CLI takes before mutating a shared host
# file (tool-enable-disable.md §2.4). It is per-machine runtime state, and it
# persists by design — unlinking a lock file races the next writer. The pattern
# is broad because the lock's name is the host file's, and tools differ on the
# suffix — .CLAUDE.md.lock and .CLAUDE.md.punt-import.lock both appear.
.*.lock

uv.toml
