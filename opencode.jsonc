{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "zspec": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "z-spec",
        "mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": {
      ".env": "deny",
      ".envrc": "deny",
      ".punt-labs/local/**": "deny"
    },
    "bash": {
      "make *": "allow",
      "git *": "allow",
      "rm -rf *": "deny",
      "*": "ask"
    },
    "edit": {
      "src/**": "allow",
      "examples/**": "allow",
      "docs/**": "allow"
    }
  }
}
